<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light"
    android:layoutDirection="rtl">

    <!-- Top Header / Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/primary"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_app_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="#FFFFFF"
            android:visibility="gone"
            android:contentDescription="חזרה" />

        <ImageButton
            android:id="@+id/btn_toggle_view"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_dialog_dialer"
            android:tint="#FFFFFF"
            android:contentDescription="תצוגה" />

        <ImageButton
            android:id="@+id/btn_add_new"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_input_add"
            android:tint="#FFFFFF"
            android:contentDescription="חדש" />

        <ImageButton
            android:id="@+id/btn_menu_sort"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_sort_alphabetically"
            android:tint="#FFFFFF"
            android:contentDescription="מיון" />
    </LinearLayout>

    <!-- Breadcrumb / Filter Toolbar -->
    <LinearLayout
        android:id="@+id/bar_breadcrumb"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:elevation="2dp"
        android:orientation="horizontal">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/container_breadcrumbs"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <EditText
            android:id="@+id/et_quick_filter"
            android:layout_width="140dp"
            android:layout_height="36dp"
            android:hint="סינון מהיר..."
            android:textSize="13sp"
            android:background="@drawable/bg_rounded_card"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Main Content Container (Tabs Host) -->
    <FrameLayout
        android:id="@+id/content_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Home View -->
        <ScrollView
            android:id="@+id/view_home"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="אחסונים זמינים"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/container_storage_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ספריות מדיה"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main"
                    android:layout_marginBottom="8dp" />

                <GridLayout
                    android:id="@+id/grid_media_categories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="4"
                    android:rowCount="2"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="קיצורי דרך מהירים"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/container_shortcuts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="כלים שימושיים"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_home_analyzer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ניתוח שטח"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_rounded_button"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btn_home_search"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="חיפוש מתקדם"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_rounded_button"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- File Explorer View -->
        <FrameLayout
            android:id="@+id/view_explorer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <ListView
                android:id="@+id/lv_files"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="#E2E8F0"
                android:dividerHeight="1dp" />

            <GridView
                android:id="@+id/gv_files"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:numColumns="3"
                android:verticalSpacing="8dp"
                android:horizontalSpacing="8dp"
                android:padding="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/empty_folder"
                android:textSize="18sp"
                android:textColor="@color/text_muted"
                android:visibility="gone" />
        </FrameLayout>

    </FrameLayout>

    <!-- Multi Selection Toolbar -->
    <LinearLayout
        android:id="@+id/bar_selection_action"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/primary"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:visibility="gone"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_selected_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_action_copy"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="העתק"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_rounded_button"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_action_move"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="העבר"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_rounded_button"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_action_delete"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="מחק"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_rounded_button"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_action_more"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="עוד..."
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_rounded_button" />

    </LinearLayout>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:id="@+id/tv_nav_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_home"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_explorer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:id="@+id/tv_nav_explorer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_explorer"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_analyzer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:id="@+id/tv_nav_analyzer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_analyzer"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:id="@+id/tv_nav_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_search"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
